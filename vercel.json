{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron?task=unilateral",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron?task=trust-scores",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron?task=cheating",
      "schedule": "0 3 * * 0"
    }
  ]
}
