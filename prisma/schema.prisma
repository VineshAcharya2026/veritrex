generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  phone            String?             @unique
  passwordHash     String
  role             Role                @default(MENTEE)
  status           UserStatus          @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  profile          Profile?
  mentorProfile    MentorProfile?
  menteeProfile    MenteeProfile?
  auditLogs        AuditLog[]
  notifications    Notification[]
  loginEvents      LoginEvent[]
  mentorSessions   Mentorship[]        @relation("MentorUser")
  menteeSessions   Mentorship[]        @relation("MenteeUser")
  memberReflection MemberReflection?
  ratingsGiven     SessionRating[]     @relation("RaterUser")
  ratingsReceived  SessionRating[]     @relation("RatedUser")
  endorsementsGiven    UserEndorsement[] @relation("Endorser")
  endorsementsReceived UserEndorsement[] @relation("Endorsed")
  trustScore       TrustScoreRecord?
  strikes          ReliabilityStrike[]
  feedPosts        FeedPost[]
  feedLikes        FeedLike[]
  feedComments     FeedComment[]
  feedBookmarks    FeedBookmark[]
  messageThreadsA  MessageThread[] @relation("ThreadParticipantA")
  messageThreadsB  MessageThread[] @relation("ThreadParticipantB")
  messagesSent     Message[]
  nationBuildingEntries NationBuildingEntry[]
  nationBuildingBadges  MentorNationBuildingBadge[]
}

enum LeadershipLoneliness {
  FREQUENTLY
  OCCASIONALLY
  RARELY
  NEVER
}

enum GentleCommitment {
  YES_REFLECTS_INTENTIONS
  STILL_EXPLORING
}

model MemberReflection {
  id                        String                @id @default(cuid())
  userId                    String                @unique
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  introduction              String?               @db.Text
  proudestAchievement       String?               @db.Text
  guidingValues             String?               @db.Text
  standFor                  String?               @db.Text
  admiredPerson             String?               @db.Text
  meaningPurpose            String?               @db.Text
  dreamMission              String?               @db.Text
  societalAspiration        String?               @db.Text
  othersDescribeYou         String?               @db.Text
  valuedQualities           String[]
  energizingPeople          String?               @db.Text
  differentBeliefsApproach  String?               @db.Text
  confidentialityImportance Int?
  supportWays               String[]
  contributions             String?               @db.Text
  leadershipLoneliness      LeadershipLoneliness?
  supportNeeded             String?               @db.Text
  sharingTopics             String?               @db.Text
  rememberedFor             String?               @db.Text
  additionalNotes           String?               @db.Text
  gentleCommitment          GentleCommitment?
  completedAt               DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

enum Role {
  SUPER_ADMIN
  MENTOR
  MENTEE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  FROZEN
  DELETED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  preferredName String?
  avatar        String?
  coverImage    String?
  bio           String?
}

enum SeniorityLevel {
  MID
  SENIOR
  EXECUTIVE
  FOUNDER
}

enum CreditType {
  MENTORSHIP_COMPLETED
  RATING_BONUS
  NATION_BUILDING_OUTCOME
  FREE_MENTORSHIP
  CONTENT_PUBLISHED
  ADMIN_ADJUSTMENT
}

enum OutcomeType {
  PLACED
  PROMOTED
  STARTED_VENTURE
  CHANGED_INDUSTRY
  CHANGED_JOB
}

enum NationBuildingCategory {
  FREE_MENTORING
  UNDERPRIVILEGED_MENTEES
  CAREER_GROWTH
  JOBS_REFERRALS
  STARTUP_SUCCESS
  GROUP_MENTORING
  MASTERCLASSES
  COMMUNITY_SERVICE
  VOLUNTEER_HOURS
  IMPACT_STORY
}

enum NationBuildingSource {
  MANUAL
  PLATFORM
}

enum NationBuildingBadge {
  COMMUNITY_MENTOR
  CAREER_CATALYST
  STARTUP_ENABLER
  EDUCATION_CHAMPION
  OPPORTUNITY_CREATOR
  NATION_BUILDER
}

enum ContentType {
  POST
  PODCAST
  VIDEO
  IMAGE
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
}

enum InnerCircleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionOutcome {
  COMPLETED
  MENTOR_NO_SHOW
  MENTEE_NO_SHOW
  MUTUAL_CANCEL
  LATE_CANCEL
}

enum TrustTier {
  EMERGING
  ESTABLISHED
  RECOGNISED
  DISTINGUISHED
}

enum MenteeCurrentStatus {
  STUDENT
  GRADUATE
  PROFESSIONAL
  ENTREPRENEUR
  CAREER_BREAK
  CAREER_SWITCHER
}

enum MentoringFormat {
  VIDEO
  AUDIO
  CHAT
  GROUP
  ASYNC
}

enum StrikeReason {
  NO_SHOW
  LATE_CANCEL
}

model MentorProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                String?
  title                  String?
  expertise              String[]
  yearsExp               Int?
  maxMentees             Int             @default(5)
  linkedInUrl            String?
  city                   String?
  industry               String?
  seniorityLevel         SeniorityLevel?
  interests              String[]        @default([])
  isEliteFounder100      Boolean         @default(false)
  thoughtLeadershipScore Int             @default(0)
  creditsBalance         Int             @default(0)
  offersFreeMentorship   Boolean         @default(false)
  freeMentorshipMinutesUsed Int          @default(0)

  // Phase 1 questionnaire fields
  professionalHeadline   String?           @db.VarChar(120)
  professionalSummary    String?           @db.Text
  threeWords             String[]          @default([])
  areasOfExpertise       String[]          @default([])
  industriesWorked       String[]          @default([])
  yearsOfExperienceRange String?
  whyMentor              String?           @db.Text
  preferredMenteeTypes   String[]          @default([])
  challengesCanHelp      String[]          @default([])
  mentoringStyle         String[]          @default([])
  sessionExpectations    String?           @db.Text
  menteeExpectations     String?           @db.Text
  achievements           String?           @db.Text
  certifications         String?
  personalInterests      String[]          @default([])
  influentialQuote       String?           @db.Text
  preferredFormats       MentoringFormat[]
  languages              String[]          @default([])
  completeSentence       String?           @db.Text
  welcomeMessage         String?           @db.Text

  skills                 MentorSkill[]
  content                MentorContent[]
  creditLedger           CreditLedger[]
  ratingsReceived        MentorshipRating[]      @relation("MentorRatings")
  innerCircleApplication InnerCircleApplication?
}

model MenteeProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole   String?
  goals         String?
  desiredSkills String[]

  // Onboarding questionnaire fields
  country                String?
  city                   String?
  currentStatus          MenteeCurrentStatus?
  highestQualification   String?
  currentInstitution     String?
  currentDesignation     String?
  yearsOfExperience      String?
  preferredIndustry      String?
  careerGoal             String?              @db.Text
  guidanceAreas          String[]             @default([])
  skillsToDevelo         String[]             @default([])
  preferredMentorProfile String?              @db.Text
  preferredModes         MentoringFormat[]
  languages              String[]             @default([])
  biggestChallenge       String?              @db.Text
  successDefinition      String?              @db.Text
  linkedInUrl            String?
}

model Mentorship {
  id                   String              @id @default(cuid())
  mentorId             String
  menteeId             String
  mentor               User                @relation("MentorUser", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee               User                @relation("MenteeUser", fields: [menteeId], references: [id], onDelete: Cascade)
  status               MentorshipStatus    @default(PENDING)
  message              String?
  isFreeOrConcessional Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  rating               MentorshipRating?
  outcomes             MentorshipOutcome[]
  creditEntries        CreditLedger[]
  sessions             MentorshipSession[]

  @@unique([mentorId, menteeId])
}

model MentorshipSession {
  id              String              @id @default(cuid())
  mentorshipId    String
  mentorship      Mentorship          @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  completedAt     DateTime?
  outcome         SessionOutcome?
  outcomeLoggedBy String?
  durationMinutes Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ratings         SessionRating[]
  strikes         ReliabilityStrike[]
}

model SessionRating {
  id          String            @id @default(cuid())
  sessionId   String
  session     MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  raterId     String
  rater       User              @relation("RaterUser", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUserId String
  ratedUser   User              @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)
  raterRole   Role

  // Mentee-rates-mentor dimensions (null when mentor rates mentee)
  impact                Int?
  productivity          Int?
  goalAchievement       Int?
  realisticLearningPath Int?
  approach              Int?
  mannersRespect        Int?

  // Mentor-rates-mentee dimensions (null when mentee rates mentor)
  preparedness     Int?
  taskCompletion   Int?
  sessionGoals     Int?
  implementation   Int?
  growth           Int?
  respectBehavior  Int?

  weightedScore Float
  isUnilateral  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([sessionId, raterId])
}

model ReliabilityStrike {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reason    StrikeReason
  createdAt DateTime          @default(now())
}

model TrustScoreRecord {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationScore   Float     @default(0)
  ratingScore         Float     @default(0)
  activityScore       Float     @default(0)
  outcomeScore        Float     @default(0)
  endorsementScore    Float     @default(0)
  totalScore          Float     @default(0)
  tier                TrustTier @default(EMERGING)
  tierPromotionCycles Int       @default(0)
  tierDemotionWarned  Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
}

model CheatFlag {
  id             String   @id @default(cuid())
  mentorUserId   String
  menteeUserId   String
  reason         String   @db.Text
  pairAvgScore   Float?
  othersAvgScore Float?
  sessionCount   Int?
  reviewed       Boolean  @default(false)
  adminNotes     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserEndorsement {
  id         String   @id @default(cuid())
  endorserId String
  endorser   User     @relation("Endorser", fields: [endorserId], references: [id], onDelete: Cascade)
  endorsedId String
  endorsed   User     @relation("Endorsed", fields: [endorsedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([endorserId, endorsedId])
  @@index([endorsedId])
}

model MentorSkill {
  id           String        @id @default(cuid())
  mentorId     String
  mentor       MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  skill        String
  masteryLevel Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([mentorId, skill])
}

model CreditLedger {
  id           String        @id @default(cuid())
  mentorId     String
  mentor       MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  amount       Int
  type         CreditType
  reason       String?
  mentorshipId String?
  mentorship   Mentorship?   @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
}

model MentorshipRating {
  id           String        @id @default(cuid())
  mentorshipId String        @unique
  mentorship   Mentorship    @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       MentorProfile @relation("MentorRatings", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId     String
  rating       Int
  review       String?       @db.Text
  createdAt    DateTime      @default(now())
}

model MentorshipOutcome {
  id           String      @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentorId     String
  outcomeType  OutcomeType
  city         String?
  industry     String?
  notes        String?     @db.Text
  verified     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model NationBuildingEntry {
  id           String                 @id @default(cuid())
  mentorId     String
  mentor       User                   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  category     NationBuildingCategory
  title        String
  description  String?                @db.Text
  quantity     Int                    @default(0)
  eventDate    DateTime?
  location     String?
  testimonial  String?                @db.Text
  evidenceUrls String[]               @default([])
  mentorshipId String?
  source       NationBuildingSource   @default(MANUAL)
  externalRef  String?
  verified     Boolean                @default(false)
  verifiedAt   DateTime?
  verifiedBy   String?
  adminNotes   String?                @db.Text
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([mentorId])
  @@index([category])
  @@unique([mentorId, source, externalRef])
}

model MentorNationBuildingBadge {
  id       String              @id @default(cuid())
  mentorId String
  mentor   User                @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  badge    NationBuildingBadge
  earnedAt DateTime            @default(now())

  @@unique([mentorId, badge])
  @@index([mentorId])
}

model MentorContent {
  id          String        @id @default(cuid())
  mentorId    String
  mentor      MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  type        ContentType
  title       String
  description String?       @db.Text
  fileUrl     String
  storageKey  String?
  mimeType    String?
  fileSize    Int?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
}

model FeedPost {
  id         String      @id @default(cuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type       ContentType
  title      String
  body       String?     @db.Text
  mediaUrl   String?
  storageKey String?
  mimeType   String?
  fileSize   Int?
  createdAt  DateTime    @default(now())
  likes      FeedLike[]
  comments   FeedComment[]
  bookmarks  FeedBookmark[]

  @@index([createdAt])
  @@index([authorId])
}

model FeedBookmark {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model MessageThread {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ThreadParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ThreadParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

model FeedLike {
  id        String       @id @default(cuid())
  postId    String
  post      FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model InnerCircleApplication {
  id                    String            @id @default(cuid())
  mentorId              String            @unique
  mentor                MentorProfile     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  whyJoin               String?           @db.Text
  whatYouBring          String?           @db.Text
  nationBuildingCommit  String?           @db.Text
  thoughtLeadershipRefs String?           @db.Text
  gentleCommitment      Boolean           @default(false)
  status                InnerCircleStatus @default(PENDING)
  adminNotes            String?           @db.Text
  submittedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  role      Role
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Blacklist {
  id        String   @id @default(cuid())
  type      String
  value     String   @unique
  reason    String?
  addedBy   String
  createdAt DateTime @default(now())
}

model PlatformConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}
