# Cloudflare Workers (production) — copy to `.dev.vars` for local wrangler preview
# Generate: openssl rand -base64 32

AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:8787

# Optional — daily integrity jobs (GET /api/cron with Authorization: Bearer …)
CRON_SECRET=

# Optional — when R2 mentor bucket is enabled in wrangler.toml
R2_PUBLIC_URL=

# Legacy local Postgres tooling only (prisma CLI); runtime DB is Cloudflare D1
# DATABASE_URL="postgresql://..."

# Email — nodemailer SMTP does not run on Workers; use an HTTP provider when enabling mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Veritrex <noreply@veritrex.org>"
