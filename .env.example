# Database — PostgreSQL required (Cloudflare Workers cannot use SQLite)
# Use Neon/Supabase with a pooled connection string for serverless:
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connect_timeout=15"

# NextAuth — required for production
NEXTAUTH_URL="http://localhost:3000"
# On Cloudflare set to: https://your-app.workers.dev (no trailing slash)
NEXTAUTH_SECRET="generate-a-strong-secret-with-openssl-rand-base64-32"

# Cloudflare R2 — public URL for mentor content (enable R2 public access or custom domain)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Email (SendGrid SMTP) — use REST APIs on Workers if enabling email later
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
EMAIL_FROM="TrustHire <noreply@trusthire.com>"

# Twilio WhatsApp (optional — use REST fetch on Workers if enabling)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Cron secret (for /api/cron — call via Cloudflare Cron or external scheduler)
CRON_SECRET=""
